# include <stdio.h>
//piramide de numeros
int main(){
    int i, j, N;

    printf("Informe o valor de N: ");
    scanf("%d", &N);

    if (2 <= N)
    {
      for (i = 1; i <= N; i++){
              for(j = 1; j <= N - i; j++){
            printf (" ");
        }
        for(j = 1; j <= i; j++){
          
          printf("%d", j);
        }
        for (j= i - 1; j >= 1; j--)
        {
          printf("%d", j);
        }  
      printf("\n");
      }
    }
    else{
      printf("O valor deve ser igual ou maior que 2");
    }
    
    return 0;
}
