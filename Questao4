# include <stdio.h>
//losango
int main(){
    int i, j, N;

    printf("informe a largura central do losango: ");
    scanf("%d", &N);

    for (i = 0; i < N -(N/2); i++){
              for(j = 0; j < N -(N/2) - i; j++){
            printf (" ");
        }
        for(j = 0; j < i*2 - 1; j++){
          
          printf("*");
        }
        printf("\n");
    }
    
    for (i = N - N/2; i >= 1; i--){
        for(j = 1; j <= N - N/2 - i; j++){
            printf (" ");
        }
        for(j = 1; j <= i*2 - 1; j++){
          
          printf("*");
        }
        printf("\n");
    }
        
    return 0;

}